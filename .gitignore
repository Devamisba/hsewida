# Root Monorepo Git Ignore

# --- Dependencies ---
**/node_modules/
**/vendor/
/.pnp
.pnp.*

# --- Environment files ---
**/.env
**/.env.backup
**/.env.production
!.env.example
!frontend/.env.example
!backend/.env.example

# --- Build & Output ---
**/dist/
**/build/
/.next/
/out/
*.tsbuildinfo
*.zip

# --- Laravel Storage & Cache ---
backend/storage/*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/app/public/documents/*
backend/storage/app/public/capa_evidence/*
!backend/storage/app/public/.gitignore

# --- Testing & IDE ---
.phpunit.result.cache
/coverage
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
